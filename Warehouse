#include <bits/stdc++.h>
using namespace std;
int main()
{
    int n,T,d;
    cin >> n >> T >> d;
    vector<int> a(n);
    vector<int> t(n);
    for (int i=0; i<n; i++) {
        cin >> a[i];
    }
    for (int i=0; i<n; i++) {
        cin >> t[i];
    }
    vector<vector<int>> dp(1001, vector<int> (101,0));
    for (int i=0; i<1001; i++) {
        dp[i][0]=0;
    }
    for (int i=1; i<101; i++) {
        if (i<t[0]) dp[0][i]=0;
        else dp[0][i]=a[0];
    }
    int max_val=0;
    for (int i=1; i<n; i++) {
        for (int j=1; j<=T; j++) {
            if (j<t[i]) dp[i][j]=0;
            else {
                for (int k=1; k<=min(d,i); k++) {
                    dp[i][j]=max(dp[i][j], dp[i-k][j-t[i]]+a[i]);
                }
            }
        }
    }
    for (int i=0; i<n; i++) {
        max_val=max(max_val, dp[i][T]);
    }
    cout << max_val;
}
